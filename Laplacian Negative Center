import cv2
import numpy as np
import os

os.makedirs("output", exist_ok=True)

img = cv2.imread("input.jpg")

gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)

kernel = np.array([
    [0, 1, 0],
    [1, -4, 1],
    [0, 1, 0]
], dtype=np.float32)

laplacian = cv2.filter2D(
    gray,
    cv2.CV_32F,
    kernel
)

sharpened = gray.astype(np.float32) - laplacian

sharpened = np.clip(
    sharpened,
    0,
    255
).astype(np.uint8)

cv2.imwrite(
    "output/q20_laplacian_negative.jpg",
    sharpened
)

cv2.imshow("Laplacian Negative Center", sharpened)
cv2.waitKey(0)
cv2.destroyAllWindows()

print("Output saved: output/q20_laplacian_negative.jpg")
