import cv2

# Read input image
input_path = r"C:\Users\SAIL\Desktop\activity\lab\street.png"
img = cv2.imread(input_path)

if img is None:
    print("Error: Image not found!")
    exit()

# Create a blurred image
blurred = cv2.GaussianBlur(img, (5, 5), 0)

# High-boost factor
A = 2.0

# Apply high-boost filtering
high_boost = cv2.addWeighted(
    img,
    A,
    blurred,
    -(A - 1),
    0
)

# Save output
output_path = r"C:\Users\SAIL\Desktop\activity\lab\24_high_boost.png"
cv2.imwrite(output_path, high_boost)

# Display images
cv2.imshow("Original Image", img)
cv2.imshow("High-Boost Sharpened Image", high_boost)

cv2.waitKey(0)
cv2.destroyAllWindows()

print("High-Boost sharpening completed successfully.")
print("Output saved at:", output_path)
