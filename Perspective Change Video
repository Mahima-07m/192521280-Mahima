import cv2
import numpy as np
import os

os.makedirs("output", exist_ok=True)

cap = cv2.VideoCapture("input.mp4")

if not cap.isOpened():
    print("Error: Cannot open video")
    exit()

pts1 = np.float32([
    [100, 100],
    [500, 100],
    [100, 400],
    [500, 400]
])

pts2 = np.float32([
    [0, 0],
    [500, 0],
    [0, 400],
    [500, 400]
])

M = cv2.getPerspectiveTransform(pts1, pts2)

width = 500
height = 400

fps = cap.get(cv2.CAP_PROP_FPS)

if fps == 0:
    fps = 30

fourcc = cv2.VideoWriter_fourcc(*"mp4v")

out = cv2.VideoWriter(
    "output/q13_perspective_video.mp4",
    fourcc,
    fps,
    (width, height)
)

while True:

    ret, frame = cap.read()

    if not ret:
        break

    result = cv2.warpPerspective(
        frame,
        M,
        (width, height)
    )

    out.write(result)

    cv2.imshow("Perspective Video", result)

    if cv2.waitKey(1) & 0xFF == ord("q"):
        break

cap.release()
out.release()
cv2.destroyAllWindows()

print("Output saved: output/q13_perspective_video.mp4")
