import cv2
import numpy as np

# Read input image
input_path = r"D:\CS Vision\lab 28-40\input.jpg"
img = cv2.imread(input_path)

if img is None:
    print("Error: Image not found!")
    exit()

# Convert to grayscale
gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)

# Structuring element
kernel = np.ones((15, 15), np.uint8)

# Apply Black Hat
black_hat = cv2.morphologyEx(
    gray,
    cv2.MORPH_BLACKHAT,
    kernel
)

# Save output
output_path = r"D:\CS Vision\lab 28-40\35_black_hat.png"
cv2.imwrite(output_path, black_hat)

# Display
cv2.imshow("Original Image", img)
cv2.imshow("Black Hat", black_hat)

cv2.waitKey(0)
cv2.destroyAllWindows()

print("Black Hat operation completed successfully.")
print("Output saved at:", output_path)
